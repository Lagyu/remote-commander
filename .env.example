# Deployment credentials only. Copy to .env and set its permissions to 0600.
# Supply a scoped token authorized for your Cloudflare account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
REMOTE_COMMANDER_PUBLIC_URL=
REMOTE_COMMANDER_ADMIN_SECRET_FILE=.deploy/admin.key
# Filled after applying infra/access. Public admin routes fail closed without it.
REMOTE_COMMANDER_ACCESS_AUD=
REMOTE_COMMANDER_OWNER_EMAIL=
# Short-lived owner login for setup scripts; not needed by the running Mac agent.
REMOTE_COMMANDER_ACCESS_TOKEN_FILE=.deploy/access.jwt
